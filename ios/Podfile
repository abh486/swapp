# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]}
  )', __dir__]).strip

platform :ios, '17.0'

use_modular_headers!

prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'SwappIos' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :fabric_enabled => true,
    :new_arch_enabled => true
  )

  rn_maps_path = '../node_modules/react-native-maps'
  pod 'react-native-maps/Google', :path => rn_maps_path

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # Inject imports into RNFBMessaging prefix header to fix modular import compilation errors
    rnfb_messaging_pch = File.join(installer.sandbox.root.to_s, 'Target Support Files/RNFBMessaging/RNFBMessaging-prefix.pch')
    if File.exist?(rnfb_messaging_pch)
      pch_content = File.read(rnfb_messaging_pch)
      unless pch_content.include?('RCTConvert+FIRApp.h')
        pch_content.gsub!(
          '#import <UIKit/UIKit.h>',
          "#import <UIKit/UIKit.h>\n#import <React/RCTBridgeModule.h>\n#import <RNFBApp/RNFBAppModule.h>\n#import <RNFBApp/RCTConvert+FIRApp.h>"
        )
        File.write(rnfb_messaging_pch, pch_content)
      end
    end

    # Clear the modulemap file for ReactCodegen to prevent modular duplicate definition conflicts
    react_codegen_map = 'Pods/Target Support Files/ReactCodegen/ReactCodegen.modulemap'
    File.write(react_codegen_map, '') if File.exist?(react_codegen_map)

    installer.aggregate_targets.each do |target|
      target.user_project.targets.each do |user_target|
        user_target.build_phases.each do |phase|
          if phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
            phase.always_out_of_date = '1'
          end
        end
      end
      target.user_project.save
    end

    installer.pods_project.targets.each do |target|
      target.build_phases.each do |phase|
        if phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
          phase.always_out_of_date = '1'
        end
      end
      target.build_configurations.each do |build_config|
        if build_config.name == 'Release'
          build_config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
        end
        build_config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
        build_config.build_settings['SWIFT_VERSION'] = '5.0'
        build_config.build_settings['SWIFT_STRICT_CONCURRENCY'] = 'minimal'
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
        build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'

        # GCC PREPROCESSOR DEFINITIONS: Define RCT_DEPRECATED globally & disable Folly coroutines
        build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'RCT_DEPRECATED='
        build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'FOLLY_CFG_NO_COROUTINES=1'
        build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'FOLLY_HAS_COROUTINES=0'

        if target.name == 'RNReanimated'
          defs = build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
          defs = defs.reject { |d| d.to_s.include?('HERMES_ENABLE_DEBUGGER') }
          defs << 'HERMES_ENABLE_DEBUGGER=0'
          build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
        end

        # Turn off modules for ReactCodegen only to avoid duplicate declaration issues
        if target.name == 'ReactCodegen'
          build_config.build_settings['DEFINES_MODULE'] = 'NO'
          build_config.build_settings['MODULEMAP_FILE'] = ''
        end

        # Enable SWIFT_OBJC_INTEROP_MODE = objcxx ONLY for JSI / Nitro C++ Swift modules.
        objcxx_targets = ['VisionCamera', 'VisionCameraBarcodeScanner', 'NitroModules', 'NitroImage']
        if objcxx_targets.include?(target.name)
          build_config.build_settings['SWIFT_OBJC_INTEROP_MODE'] = 'objcxx'
        end

        if target.name == 'ChargebeeReactNative'
          build_config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
        end

        if target.name == 'Auth0' || target.name == 'A0Auth0'
          build_config.build_settings['SWIFT_VERSION'] = '5.0'
          build_config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
        end

        # Ensure SwappIos target can import GoogleMaps xcframework modules
        if target.name == 'SwappIos'
          build_config.build_settings['SWIFT_INCLUDE_PATHS'] ||= '$(inherited)'
          build_config.build_settings['SWIFT_INCLUDE_PATHS'] += ' "${PODS_ROOT}/GoogleMaps/Maps/Frameworks"'
        end
      end
    end
  end
end
