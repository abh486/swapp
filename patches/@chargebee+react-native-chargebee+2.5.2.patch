+class ChargebeeReactNativePackage : TurboReactPackage() {
+  override fun getModule(name: String, reactContext: ReactApplicationContext): NativeModule? {
+    return if (name == ChargebeeReactNativeModule.NAME) {
+      ChargebeeReactNativeModule(reactContext)
+    } else {
+      null
+    }
+  }
