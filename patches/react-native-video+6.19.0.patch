diff --git a/node_modules/react-native-video/android/bin/src/main/java/com/brentvatne/common/react/VideoEventEmitter.kt b/node_modules/react-native-video/android/bin/src/main/java/com/brentvatne/common/react/VideoEventEmitter.kt
